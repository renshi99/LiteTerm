<Window x:Class="LiteTerm.App.ServerLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="常用日志" Height="620" Width="900" MinHeight="540" MinWidth="800"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="当前服务器" Foreground="{DynamicResource MutedTextBrush}" />
            <TextBlock x:Name="ServerNameText" Grid.Row="1" Margin="0,4,0,12" FontSize="15"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <ListBox x:Name="LogList" Grid.Row="2" DisplayMemberPath="Name"
                     Background="{DynamicResource ListBackgroundBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     SelectionChanged="LogList_SelectionChanged" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="新增" Width="76" Height="30" Margin="0,0,8,0" Click="New_Click" />
                <Button Content="删除" Width="76" Height="30" Click="Delete_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="日志名称" Foreground="{DynamicResource MutedTextBrush}" />
            <TextBox x:Name="NameTextBox" Grid.Row="1" Height="34" Margin="0,5,0,14" Padding="8,4"
                     Background="{DynamicResource ListBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" TextChanged="Editor_TextChanged" />

            <TextBlock Grid.Row="2" Text="远程日志绝对路径" Foreground="{DynamicResource MutedTextBrush}" />
            <TextBox x:Name="RemotePathTextBox" Grid.Row="3" Height="34" Margin="0,5,0,14" Padding="8,4"
                     FontFamily="Consolas" Background="{DynamicResource ListBackgroundBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                     TextChanged="Editor_TextChanged" />

            <Border Grid.Row="4" Padding="12" Background="{DynamicResource AlternateBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="持续追踪预览" FontWeight="SemiBold" />
                    <TextBox x:Name="FollowPreviewTextBox" Grid.Row="1" Height="58" Margin="0,7,0,10" Padding="8,6"
                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" Background="{DynamicResource ListBackgroundBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                    <TextBlock Grid.Row="2" Text="进入目录预览" FontWeight="SemiBold" />
                    <TextBox x:Name="EnterDirectoryPreviewTextBox" Grid.Row="3" Height="58" Margin="0,7,0,8" Padding="8,6"
                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" Background="{DynamicResource ListBackgroundBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                    <TextBlock x:Name="ValidationText" Grid.Row="4" Foreground="#EF4444" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Button Grid.Row="5" Content="应用当前编辑" Width="110" Height="30" Margin="0,10,0,0"
                    HorizontalAlignment="Left" Click="Apply_Click" />
        </Grid>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Width="78" Height="32" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="保存配置" Width="92" Height="32" Margin="0,0,8,0" Click="Save_Click" />
            <Button Content="进入目录" Width="92" Height="32" Margin="0,0,8,0" Click="EnterDirectory_Click" />
            <Button Content="追踪日志" Width="92" Height="32" IsDefault="True" Click="Follow_Click" />
        </StackPanel>
    </Grid>
</Window>
