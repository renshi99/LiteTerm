<Window x:Class="LiteTerm.App.TerminalAppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外观设置" Width="640" Height="580" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="终端外观" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,5,0,14" Foreground="{DynamicResource MutedTextBrush}"
                   Text="调整应用主题以及终端的配色、字体和滚动行数。" />

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="应用主题" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="DarkThemeRadioButton" Content="深色" GroupName="ApplicationTheme"
                             Margin="0,0,28,0" />
                <RadioButton x:Name="LightThemeRadioButton" Content="浅色" GroupName="ApplicationTheme" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="配色方案" VerticalAlignment="Center" />
            <ComboBox x:Name="PresetComboBox" Grid.Column="1" Height="34" SelectedIndex="0"
                      SelectionChanged="Preset_SelectionChanged">
                <ComboBoxItem Content="夜空（推荐）" />
                <ComboBoxItem Content="纯黑高对比" />
                <ComboBoxItem Content="柔和灰黑" />
                <ComboBoxItem Content="浅色" />
                <ComboBoxItem Content="自定义" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="文字颜色" VerticalAlignment="Center" />
            <Grid Grid.Column="1" Margin="0,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ForegroundTextBox" TextChanged="Color_TextChanged" MaxLength="7" />
                <Button Grid.Column="1" Padding="8,4" ToolTip="可视化选择文字颜色"
                        Click="ChooseForegroundColor_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="ForegroundSwatch" Width="18" Height="18" Margin="0,0,6,0"
                                BorderBrush="{DynamicResource DimTextBrush}" BorderThickness="1" />
                        <TextBlock Text="选择" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Grid.Column="2" Text="背景颜色" VerticalAlignment="Center" />
            <Grid Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="BackgroundTextBox" TextChanged="Color_TextChanged" MaxLength="7" />
                <Button Grid.Column="1" Padding="8,4" ToolTip="可视化选择背景颜色"
                        Click="ChooseBackgroundColor_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="BackgroundSwatch" Width="18" Height="18" Margin="0,0,6,0"
                                BorderBrush="{DynamicResource DimTextBrush}" BorderThickness="1" />
                        <TextBlock Text="选择" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="终端字体" VerticalAlignment="Center" />
            <TextBox x:Name="FontFamilyTextBox" Grid.Column="1" Margin="0,0,14,0"
                     TextChanged="DisplaySetting_TextChanged" MaxLength="128" />
            <TextBlock Grid.Column="2" Text="字号" VerticalAlignment="Center" />
            <TextBox x:Name="FontSizeTextBox" Grid.Column="3" TextChanged="DisplaySetting_TextChanged"
                     MaxLength="2" ToolTip="允许 8～32" />

            <TextBlock Grid.Row="1" Margin="0,10,0,0" Text="滚动行数" VerticalAlignment="Center" />
            <TextBox x:Name="ScrollbackTextBox" Grid.Row="1" Grid.Column="1" Margin="0,10,14,0"
                     TextChanged="DisplaySetting_TextChanged" MaxLength="6" ToolTip="允许 100～100000" />
            <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,10,0,0"
                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"
                       Text="限制终端历史输出，避免内存无限增长" />
        </Grid>

        <Border Grid.Row="6" x:Name="PreviewBorder" Margin="0,18,0,18" Padding="16"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <TextBlock x:Name="PreviewTitle" Text="LiteTerm 终端预览" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="PreviewText" Margin="0,10,0,0" FontFamily="Cascadia Mono, Consolas"
                           Text="root@server:~# tail -F application.log&#x0a;服务已启动，等待连接…" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="恢复默认" Click="RestoreDefault_Click" />
            <Button Grid.Column="2" Content="取消" IsCancel="True" />
            <Button Grid.Column="3" Content="保存" IsDefault="True" Click="Save_Click" />
        </Grid>
    </Grid>
</Window>
