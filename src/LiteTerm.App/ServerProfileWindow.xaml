<Window x:Class="LiteTerm.App.ServerProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务器资料" Height="720" Width="620" MinHeight="620" MinWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="18,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,8,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="126" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="88" />
                </Grid.RowDefinitions>

                <TextBlock Text="名称 *" />
                <TextBox x:Name="NameTextBox" Grid.Column="1" />
                <TextBlock Grid.Row="1" Text="分组" />
                <TextBox x:Name="GroupTextBox" Grid.Row="1" Grid.Column="1" />
                <TextBlock Grid.Row="2" Text="主机 / IP *" />
                <TextBox x:Name="HostTextBox" Grid.Row="2" Grid.Column="1" />
                <TextBlock Grid.Row="3" Text="端口 *" />
                <TextBox x:Name="PortTextBox" Grid.Row="3" Grid.Column="1" Text="22" />
                <TextBlock Grid.Row="4" Text="用户名 *" />
                <TextBox x:Name="UsernameTextBox" Grid.Row="4" Grid.Column="1" />
                <TextBlock Grid.Row="5" Text="认证方式" />
                <ComboBox x:Name="AuthenticationComboBox" Grid.Row="5" Grid.Column="1" Height="34"
                          SelectedIndex="0" SelectionChanged="Authentication_SelectionChanged">
                    <ComboBoxItem Content="密码" />
                    <ComboBoxItem Content="私钥" />
                </ComboBox>
                <TextBlock x:Name="PasswordLabel" Grid.Row="6" Text="密码" />
                <PasswordBox x:Name="PasswordInput" Grid.Row="6" Grid.Column="1" />
                <TextBlock x:Name="PrivateKeyLabel" Grid.Row="6" Text="私钥文件 *" Visibility="Collapsed" />
                <Grid x:Name="PrivateKeyPanel" Grid.Row="6" Grid.Column="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PrivateKeyPathTextBox" />
                    <Button Grid.Column="1" Content="浏览…" Click="BrowsePrivateKey_Click" />
                </Grid>
                <TextBlock x:Name="PassphraseLabel" Grid.Row="7" Text="私钥口令" Visibility="Collapsed" />
                <PasswordBox x:Name="PrivateKeyPassphraseInput" Grid.Row="7" Grid.Column="1" Visibility="Collapsed" />
                <TextBlock Grid.Row="8" Text="默认远程目录" />
                <TextBox x:Name="DefaultRemotePathTextBox" Grid.Row="8" Grid.Column="1" />
                <TextBlock Grid.Row="9" Text="连接超时（秒）" />
                <TextBox x:Name="ConnectTimeoutTextBox" Grid.Row="9" Grid.Column="1" Text="15" />
                <TextBlock Grid.Row="10" Text="KeepAlive（秒）" />
                <TextBox x:Name="KeepAliveTextBox" Grid.Row="10" Grid.Column="1" Text="30" />
                <TextBlock Grid.Row="11" Text="备注" />
                <TextBox x:Name="RemarkTextBox" Grid.Row="11" Grid.RowSpan="2" Grid.Column="1"
                         Height="78" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" />
            <Button Content="保存" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
