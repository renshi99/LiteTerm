<Window x:Class="LiteTerm.App.SftpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SFTP 文件浏览" Height="620" Width="920" MinHeight="420" MinWidth="700"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ParentButton" Content="上级" Width="66" Height="32" Margin="0,0,8,0"
                    Click="Parent_Click" IsEnabled="False" />
            <TextBox x:Name="PathTextBox" Grid.Column="1" Height="32" Padding="8,4" Margin="0,0,8,0"
                     KeyDown="PathTextBox_KeyDown" IsEnabled="False" />
            <Button x:Name="GoButton" Grid.Column="2" Content="转到" Width="66" Height="32" Margin="0,0,8,0"
                    Click="Go_Click" IsEnabled="False" />
            <Button x:Name="RefreshButton" Grid.Column="3" Content="刷新" Width="66" Height="32"
                    Click="Refresh_Click" IsEnabled="False" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal">
            <Button x:Name="UploadButton" Content="上传文件" Width="82" Height="30" Margin="0,0,8,0"
                    Click="Upload_Click" IsEnabled="False" />
            <Button x:Name="DownloadButton" Content="下载文件" Width="82" Height="30"
                    Margin="0,0,8,0" Click="Download_Click" IsEnabled="False" />
            <Button x:Name="NewDirectoryButton" Content="新建目录" Width="82" Height="30"
                    Margin="0,0,8,0" Click="NewDirectory_Click" IsEnabled="False" />
            <Button x:Name="RenameButton" Content="重命名" Width="74" Height="30"
                    Margin="0,0,8,0" Click="Rename_Click" IsEnabled="False" />
            <Button x:Name="DeleteButton" Content="删除" Width="66" Height="30"
                    Click="Delete_Click" IsEnabled="False" />
            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                       Text="也可将本地文件拖到下方列表上传" />
        </StackPanel>

        <DataGrid x:Name="FileGrid" Grid.Row="2" Margin="0,10,0,10" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" MouseDoubleClick="FileGrid_MouseDoubleClick"
                  SelectionChanged="FileGrid_SelectionChanged"
                  AllowDrop="True" PreviewDragOver="FileGrid_PreviewDragOver"
                  DragLeave="FileGrid_DragLeave" Drop="FileGrid_Drop"
                  Background="{DynamicResource ListBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" RowBackground="{DynamicResource ListBackgroundBrush}"
                  AlternatingRowBackground="{DynamicResource AlternateBackgroundBrush}"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource SubtleBorderBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="220" />
                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="95" />
                <DataGridTextColumn Header="大小" Binding="{Binding Size, StringFormat={}{0:N0}}" Width="115" />
                <DataGridTextColumn Header="权限" Binding="{Binding Permissions}" Width="105" />
                <DataGridTextColumn Header="修改时间 (UTC)" Binding="{Binding LastWriteTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="165" />
            </DataGrid.Columns>
        </DataGrid>

        <Border x:Name="TransferPanel" Grid.Row="3" Margin="0,0,0,10" Padding="10"
                Background="{DynamicResource AlternateBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TransferTitleText" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                <Button x:Name="CancelTransferButton" Grid.Column="1" Grid.RowSpan="2"
                        Content="取消" Width="66" Height="30" Margin="12,0,0,0"
                        Click="CancelTransfer_Click" IsEnabled="False" />
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="TransferProgressBar" Height="12" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="TransferProgressText" Grid.Column="1" Margin="10,-3,0,0"
                               MinWidth="200" TextAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="4" Text="正在建立独立 SFTP 连接…"
                   Foreground="{DynamicResource MutedTextBrush}" />
    </Grid>
</Window>
