<Window x:Class="LiteTerm.App.SftpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SFTP 文件浏览" Height="620" Width="920" MinHeight="420" MinWidth="700"
        WindowStartupLocation="CenterOwner" Background="#111827">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ParentButton" Content="上级" Width="66" Height="32" Margin="0,0,8,0"
                    Click="Parent_Click" IsEnabled="False" />
            <TextBox x:Name="PathTextBox" Grid.Column="1" Height="32" Padding="8,4" Margin="0,0,8,0"
                     KeyDown="PathTextBox_KeyDown" IsEnabled="False" />
            <Button x:Name="GoButton" Grid.Column="2" Content="转到" Width="66" Height="32" Margin="0,0,8,0"
                    Click="Go_Click" IsEnabled="False" />
            <Button x:Name="RefreshButton" Grid.Column="3" Content="刷新" Width="66" Height="32"
                    Click="Refresh_Click" IsEnabled="False" />
        </Grid>

        <DataGrid x:Name="FileGrid" Grid.Row="1" Margin="0,12,0,10" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" MouseDoubleClick="FileGrid_MouseDoubleClick"
                  Background="#0F172A" Foreground="#E5E7EB" BorderBrush="#374151"
                  RowBackground="#0F172A" AlternatingRowBackground="#172033"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#273449">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="220" />
                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="95" />
                <DataGridTextColumn Header="大小" Binding="{Binding Size, StringFormat={}{0:N0}}" Width="115" />
                <DataGridTextColumn Header="权限" Binding="{Binding Permissions}" Width="105" />
                <DataGridTextColumn Header="修改时间 (UTC)" Binding="{Binding LastWriteTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="165" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="正在建立独立 SFTP 连接…"
                   Foreground="#9CA3AF" />
    </Grid>
</Window>
