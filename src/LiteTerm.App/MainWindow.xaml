<Window x:Class="LiteTerm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LiteTerm.App"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="LiteTerm" Height="720" Width="1280" MinHeight="520" MinWidth="1050"
        WindowStartupLocation="CenterScreen" Background="#111827">
    <Window.Resources>
        <local:LastConnectedAtConverter x:Key="LastConnectedAtConverter" />
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="15,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3" Background="#111827" BorderBrush="#374151" BorderThickness="0,0,1,0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="已保存的服务器" Foreground="#F3F4F6" FontSize="16" FontWeight="SemiBold" Margin="2,2,0,10" />
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ServerSearchTextBox" Height="32" Margin="0" Padding="28,4,8,4"
                             ToolTip="按名称、分组、主机或用户名搜索"
                             TextChanged="ServerSearchTextBox_TextChanged" />
                    <TextBlock Text="⌕" Foreground="#6B7280" FontSize="17" Margin="8,0,0,1"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock x:Name="ServerCountText" Grid.Column="1" Foreground="#9CA3AF" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,2,0" />
                </Grid>
                <DockPanel Grid.Row="2" Margin="0,0,0,8">
                    <TextBlock Text="排序" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"
                               Margin="2,0,8,0" />
                    <ComboBox x:Name="ServerSortComboBox" Height="28" SelectedIndex="0"
                              SelectionChanged="ServerSortComboBox_SelectionChanged">
                        <ComboBoxItem Content="按名称" Tag="Name" />
                        <ComboBoxItem Content="组内按最近连接" Tag="Recent" />
                    </ComboBox>
                </DockPanel>
                <ListBox x:Name="ServerList" Grid.Row="3" Background="#0F172A" Foreground="#E5E7EB"
                         BorderBrush="#374151" MouseDoubleClick="ServerList_MouseDoubleClick">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="#172033" Padding="8,5" Margin="0,5,0,1">
                                        <TextBlock Text="{Binding Name}" Foreground="#93C5FD" FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5,4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Foreground="#9CA3AF" FontSize="11">
                                    <Run Text="{Binding Username}" /><Run Text="@" /><Run Text="{Binding Host}" />
                                </TextBlock>
                                <TextBlock Text="{Binding LastConnectedAt, Converter={StaticResource LastConnectedAtConverter}}"
                                           Foreground="#64748B" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <UniformGrid Grid.Row="4" Columns="5" Margin="0,10,0,0">
                    <Button Content="新增" Padding="5,4" Margin="0,0,4,0" Click="NewServer_Click" />
                    <Button Content="编辑" Padding="5,4" Margin="0,0,4,0" Click="EditServer_Click" />
                    <Button Content="复制" Padding="5,4" Margin="0,0,4,0" Click="CopyServer_Click" />
                    <Button Content="删除" Padding="5,4" Margin="0,0,4,0" Click="DeleteServer_Click" />
                    <Button Content="连接" Padding="5,4" Margin="0" Click="ConnectSavedServer_Click" />
                </UniformGrid>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Background="#1F2937" Padding="14,8" BorderBrush="#374151" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="主机 / IP" Foreground="#9CA3AF" FontSize="11" Margin="2,0,0,3" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="端口" Foreground="#9CA3AF" FontSize="11" Margin="2,0,0,3" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="用户名" Foreground="#9CA3AF" FontSize="11" Margin="2,0,0,3" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="认证方式" Foreground="#9CA3AF" FontSize="11" Margin="2,0,0,3" />

                <TextBox x:Name="HostTextBox" Grid.Row="1" Grid.Column="0" ToolTip="主机或 IP" />
                <TextBox x:Name="PortTextBox" Grid.Row="1" Grid.Column="1" Text="22" ToolTip="端口" />
                <TextBox x:Name="UsernameTextBox" Grid.Row="1" Grid.Column="2" ToolTip="用户名" />
                <ComboBox x:Name="AuthenticationComboBox" Grid.Row="1" Grid.Column="3" Height="34" Margin="0,0,8,0"
                          SelectedIndex="0" SelectionChanged="Authentication_SelectionChanged">
                    <ComboBoxItem Content="密码" Tag="Password" />
                    <ComboBoxItem Content="私钥" Tag="PrivateKey" />
                </ComboBox>
                <Button x:Name="ConnectButton" Grid.Row="1" Grid.Column="4" Content="连接" Click="Connect_Click" IsDefault="True" />
                <Button x:Name="DisconnectButton" Grid.Row="1" Grid.Column="5" Content="断开" Click="Disconnect_Click" IsEnabled="False" />
                <Button Grid.Row="1" Grid.Column="6" Content="终端外观" Click="TerminalAppearance_Click" Margin="0" />

                <Grid x:Name="PasswordPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="密码" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="2,0,12,0" />
                    <PasswordBox x:Name="PasswordInput" Grid.Column="1" ToolTip="仅在勾选保存并连接成功后加密保存" Margin="0" />
                </Grid>

                <Grid x:Name="PrivateKeyPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="210" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="私钥文件" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="2,0,12,0" />
                    <TextBox x:Name="PrivateKeyPathTextBox" Grid.Column="1" ToolTip="私钥文件路径" />
                    <Button x:Name="BrowsePrivateKeyButton" Grid.Column="2" Content="浏览…" Click="BrowsePrivateKey_Click" />
                    <TextBlock Grid.Column="3" Text="口令（可选）" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="2,0,12,0" />
                    <PasswordBox x:Name="PrivateKeyPassphraseInput" Grid.Column="4" ToolTip="私钥口令（可选；仅在勾选保存并连接成功后加密保存）" Margin="0" />
                </Grid>

                <CheckBox x:Name="SaveConnectionCheckBox" Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="3"
                          Content="保存至本地连接" Foreground="#D1D5DB" VerticalAlignment="Center"
                          Margin="8,8,0,0" IsChecked="True" />
            </Grid>
        </Border>

        <Border x:Name="TerminalBorder" Grid.Row="1" Grid.Column="1" Background="#050816" Padding="1">
            <wv2:WebView2 x:Name="TerminalWebView" DefaultBackgroundColor="#050816" />
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Background="#1F2937" BorderBrush="#374151" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#9CA3AF" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="正在初始化终端…" Foreground="#D1D5DB" Margin="8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="SizeText" Grid.Column="2" Text="80 × 24" Foreground="#9CA3AF" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
